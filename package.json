{
  "name": "trouvable",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "next typegen --webpack && tsc --noEmit",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test:hibernation": "node --test scripts/__tests__/hibernation.test.mjs",
    "check:hibernation": "node scripts/validate-hibernation.mjs",
    "check:repository": "node scripts/check-repository.mjs",
    "verify": "node scripts/verify.mjs",
    "test:tooling": "node --test scripts/__tests__/repository.test.mjs scripts/__tests__/verify.test.mjs"
  },
  "browserslist": {
    "production": [
      "chrome >= 109",
      "edge >= 109",
      "firefox >= 109",
      "safari >= 16.4",
      "ios_saf >= 16.4",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "overrides": {
    "postcss": "^8.5.11"
  },
  "dependencies": {
    "@clerk/localizations": "^4.2.2",
    "@clerk/nextjs": "^7.2.4",
    "@clerk/themes": "^2.4.57",
    "@marsidev/react-turnstile": "^1.4.2",
    "@mistralai/mistralai": "^2.1.2",
    "@sparticuz/chromium": "^143.0.4",
    "@supabase/supabase-js": "^2.98.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "cheerio": "^1.2.0",
    "critters": "^0.0.25",
    "framer-motion": "^12.35.0",
    "googleapis": "^171.4.0",
    "jose": "^6.2.0",
    "lucide-react": "^1.7.0",
    "next": "^16.3.8",
    "playwright-core": "^1.56.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "recharts": "^3.8.1",
    "resend": "^6.9.3",
    "server-only": "^0.0.1",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.5.0",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.1.6",
    "playwright": "^1.56.1",
    "postcss": "^8.5.11",
    "prettier": "3.9.9",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vitest": "^4.1.1"
  },
  "packageManager": "npm@11.6.2",
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0"
  }
}
